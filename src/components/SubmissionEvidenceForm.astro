---
import { ALLOWED_EVIDENCE_SOURCE_TYPES } from "../lib/submission-evidence";
---

<section class="detail-panel submit-panel evidence-preflight" aria-labelledby="evidence-preflight-title">
  <header class="submit-section-header">
    <p class="detail-overline">Required before submission</p>
    <h2 id="evidence-preflight-title" class="submit-title">Validate claim-level evidence</h2>
    <p class="submit-copy">
      Add at least one first-party source. Every source needs a descriptive title, an HTTPS URL maintained by the
      product or project, the specific claim it supports, the date you checked it, and an allowed source type.
    </p>
    <p class="submit-copy">
      This preflight checks required fields and formats. It does not prove that a URL is first-party, that a source
      supports a claim, or that a tool qualifies for the directory. Editors verify those points during PR review.
    </p>
  </header>

  <form id="submission-evidence-form" class="evidence-form" novalidate>
    <div id="evidence-error-summary" class="evidence-message evidence-message-error" tabindex="-1" hidden>
      <h3>Fix the evidence fields below</h3>
      <ul data-error-list></ul>
    </div>

    <div id="evidence-sources" class="evidence-sources">
      <fieldset class="evidence-source" data-evidence-source>
        <legend>Evidence source <span data-source-number>1</span></legend>
        <div class="evidence-fields">
          <div class="evidence-field evidence-field-wide">
            <label for="evidence-0-title">Source title <span aria-hidden="true">*</span></label>
            <input id="evidence-0-title" name="evidenceSources[0][title]" data-field="title" type="text" maxlength="200" required aria-describedby="evidence-0-title-error" />
            <p id="evidence-0-title-error" class="evidence-field-error" data-error-for="title" hidden></p>
          </div>
          <div class="evidence-field evidence-field-wide">
            <label for="evidence-0-url">First-party HTTPS URL <span aria-hidden="true">*</span></label>
            <input id="evidence-0-url" name="evidenceSources[0][url]" data-field="url" type="url" inputmode="url" maxlength="2048" placeholder="https://example.com/docs/agents" required aria-describedby="evidence-0-url-help evidence-0-url-error" />
            <p id="evidence-0-url-help" class="evidence-field-help" data-help-for="url">Use an official product, project, documentation, specification, legal, pricing, release, or repository URL.</p>
            <p id="evidence-0-url-error" class="evidence-field-error" data-error-for="url" hidden></p>
          </div>
          <div class="evidence-field evidence-field-wide">
            <label for="evidence-0-claim">Specific supported claim <span aria-hidden="true">*</span></label>
            <textarea id="evidence-0-claim" name="evidenceSources[0][claim]" data-field="claim" maxlength="1200" rows="3" required aria-describedby="evidence-0-claim-help evidence-0-claim-error"></textarea>
            <p id="evidence-0-claim-help" class="evidence-field-help" data-help-for="claim">State the precise directory claim this page supports. Do not use a generic links description.</p>
            <p id="evidence-0-claim-error" class="evidence-field-error" data-error-for="claim" hidden></p>
          </div>
          <div class="evidence-field">
            <label for="evidence-0-accessedAt">Date checked <span aria-hidden="true">*</span></label>
            <input id="evidence-0-accessedAt" name="evidenceSources[0][accessedAt]" data-field="accessedAt" type="date" required aria-describedby="evidence-0-accessedAt-error" />
            <p id="evidence-0-accessedAt-error" class="evidence-field-error" data-error-for="accessedAt" hidden></p>
          </div>
          <div class="evidence-field">
            <label for="evidence-0-sourceType">Source type <span aria-hidden="true">*</span></label>
            <select id="evidence-0-sourceType" name="evidenceSources[0][sourceType]" data-field="sourceType" required aria-describedby="evidence-0-sourceType-error">
              <option value="">Choose a source type</option>
              {ALLOWED_EVIDENCE_SOURCE_TYPES.map((sourceType) => <option value={sourceType}>{sourceType}</option>)}
            </select>
            <p id="evidence-0-sourceType-error" class="evidence-field-error" data-error-for="sourceType" hidden></p>
          </div>
          <div class="evidence-field evidence-field-wide evidence-confirmation">
            <input id="evidence-0-firstParty" name="evidenceSources[0][firstParty]" data-field="firstParty" type="checkbox" required aria-describedby="evidence-0-firstParty-help evidence-0-firstParty-error" />
            <label for="evidence-0-firstParty">I confirm this URL is maintained by the product developer or project.</label>
            <p id="evidence-0-firstParty-help" class="evidence-field-help" data-help-for="firstParty">This declaration is recorded for validation; editors still verify source ownership.</p>
            <p id="evidence-0-firstParty-error" class="evidence-field-error" data-error-for="firstParty" hidden></p>
          </div>
        </div>
        <button class="button button-secondary evidence-remove" type="button" data-remove-source hidden>Remove source 1</button>
      </fieldset>
    </div>

    <template id="evidence-source-template">
      <fieldset class="evidence-source" data-evidence-source>
        <legend>Evidence source <span data-source-number></span></legend>
        <div class="evidence-fields">
          <div class="evidence-field evidence-field-wide">
            <label>Source title <span aria-hidden="true">*</span></label>
            <input data-field="title" type="text" maxlength="200" required />
            <p class="evidence-field-error" data-error-for="title" hidden></p>
          </div>
          <div class="evidence-field evidence-field-wide">
            <label>First-party HTTPS URL <span aria-hidden="true">*</span></label>
            <input data-field="url" type="url" inputmode="url" maxlength="2048" placeholder="https://example.com/docs/agents" required />
            <p class="evidence-field-help" data-help-for="url">Use an official product, project, documentation, specification, legal, pricing, release, or repository URL.</p>
            <p class="evidence-field-error" data-error-for="url" hidden></p>
          </div>
          <div class="evidence-field evidence-field-wide">
            <label>Specific supported claim <span aria-hidden="true">*</span></label>
            <textarea data-field="claim" maxlength="1200" rows="3" required></textarea>
            <p class="evidence-field-help" data-help-for="claim">State the precise directory claim this page supports. Do not use a generic links description.</p>
            <p class="evidence-field-error" data-error-for="claim" hidden></p>
          </div>
          <div class="evidence-field">
            <label>Date checked <span aria-hidden="true">*</span></label>
            <input data-field="accessedAt" type="date" required />
            <p class="evidence-field-error" data-error-for="accessedAt" hidden></p>
          </div>
          <div class="evidence-field">
            <label>Source type <span aria-hidden="true">*</span></label>
            <select data-field="sourceType" required>
              <option value="">Choose a source type</option>
              {ALLOWED_EVIDENCE_SOURCE_TYPES.map((sourceType) => <option value={sourceType}>{sourceType}</option>)}
            </select>
            <p class="evidence-field-error" data-error-for="sourceType" hidden></p>
          </div>
          <div class="evidence-field evidence-field-wide evidence-confirmation">
            <input data-field="firstParty" type="checkbox" required />
            <label>I confirm this URL is maintained by the product developer or project.</label>
            <p class="evidence-field-help" data-help-for="firstParty">This declaration is recorded for validation; editors still verify source ownership.</p>
            <p class="evidence-field-error" data-error-for="firstParty" hidden></p>
          </div>
        </div>
        <button class="button button-secondary evidence-remove" type="button" data-remove-source>Remove source</button>
      </fieldset>
    </template>

    <div class="evidence-actions">
      <button id="add-evidence-source" class="button button-secondary" type="button">Add another source</button>
      <button id="validate-evidence" class="button button-primary" type="submit">Validate required evidence</button>
    </div>
    <p id="evidence-source-status" class="visually-hidden" aria-live="polite"></p>
  </form>

  <div id="evidence-success" class="evidence-message evidence-message-success" role="status" hidden>
    <h3>Evidence fields and formats are valid</h3>
    <p>Copy this block into the tool file. Editorial review must still confirm that each source is first-party and supports the stated claim.</p>
    <pre class="code-block" tabindex="0" aria-label="Validated evidence sources YAML"><code id="evidence-output"></code></pre>
    <button id="copy-evidence" class="button button-secondary" type="button">Copy evidence block</button>
  </div>
</section>

<script>
  import {
    MAX_EVIDENCE_SOURCES,
    validateSubmissionEvidence,
    type SubmissionEvidenceError,
    type SubmissionEvidenceSource,
  } from "../lib/submission-evidence";

  type EvidenceControl = HTMLElement & {
    checked?: boolean;
    name: string;
    value: string;
  };
  type EvidenceApiResult =
    | { ok: true; evidenceSources: SubmissionEvidenceSource[] }
    | { ok: false; errors?: SubmissionEvidenceError[]; error?: string };

  const form = document.querySelector<HTMLFormElement>("#submission-evidence-form");
  const sourcesContainer = document.querySelector<HTMLElement>("#evidence-sources");
  const sourceTemplate = document.querySelector<HTMLTemplateElement>("#evidence-source-template");
  const addButton = document.querySelector<HTMLButtonElement>("#add-evidence-source");
  const submitButton = document.querySelector<HTMLButtonElement>("#validate-evidence");
  const errorSummary = document.querySelector<HTMLElement>("#evidence-error-summary");
  const errorList = errorSummary?.querySelector<HTMLElement>("[data-error-list]");
  const status = document.querySelector<HTMLElement>("#evidence-source-status");
  const success = document.querySelector<HTMLElement>("#evidence-success");
  const output = document.querySelector<HTMLElement>("#evidence-output");
  const copyButton = document.querySelector<HTMLButtonElement>("#copy-evidence");

  function sourceFieldsets() {
    return [...(sourcesContainer?.querySelectorAll<HTMLFieldSetElement>("[data-evidence-source]") ?? [])];
  }

  function updateSourceIndexes() {
    const fieldsets = sourceFieldsets();
    fieldsets.forEach((fieldset, index) => {
      const displayNumber = index + 1;
      const sourceNumber = fieldset.querySelector<HTMLElement>("[data-source-number]");
      if (sourceNumber) sourceNumber.textContent = String(displayNumber);

      fieldset.querySelectorAll<HTMLElement>("[data-field]").forEach((field) => {
        const fieldName = field.dataset.field ?? "";
        const id = `evidence-${index}-${fieldName}`;
        field.id = id;
        (field as EvidenceControl).name = `evidenceSources[${index}][${fieldName}]`;
        const fieldContainer = field.closest<HTMLElement>(".evidence-field");
        const label = fieldContainer?.querySelector<HTMLLabelElement>("label");
        const help = fieldContainer?.querySelector<HTMLElement>(`[data-help-for="${fieldName}"]`);
        const error = fieldContainer?.querySelector<HTMLElement>(`[data-error-for="${fieldName}"]`);
        if (label) label.htmlFor = id;
        if (help) help.id = `${id}-help`;
        if (error) error.id = `${id}-error`;
        field.setAttribute("aria-describedby", [help?.id, error?.id].filter(Boolean).join(" "));
      });

      const removeButton = fieldset.querySelector<HTMLButtonElement>("[data-remove-source]");
      if (removeButton) {
        removeButton.hidden = fieldsets.length === 1;
        removeButton.textContent = `Remove source ${displayNumber}`;
        removeButton.setAttribute("aria-label", `Remove evidence source ${displayNumber}`);
      }
    });

    if (addButton) addButton.disabled = fieldsets.length >= MAX_EVIDENCE_SOURCES;
  }

  function clearErrors() {
    sourceFieldsets().forEach((fieldset) => {
      fieldset.querySelectorAll<HTMLElement>("[data-field]").forEach((field) => {
        field.removeAttribute("aria-invalid");
      });
      fieldset.querySelectorAll<HTMLElement>("[data-error-for]").forEach((error) => {
        error.hidden = true;
        error.textContent = "";
      });
    });
    if (errorList) errorList.replaceChildren();
    if (errorSummary) errorSummary.hidden = true;
  }

  function invalidateSuccess() {
    if (success) success.hidden = true;
    if (output) output.textContent = "";
  }

  function collectPayload() {
    return {
      evidenceSources: sourceFieldsets().map((fieldset) => ({
        title: fieldset.querySelector<HTMLInputElement>('[data-field="title"]')?.value ?? "",
        url: fieldset.querySelector<HTMLInputElement>('[data-field="url"]')?.value ?? "",
        claim: fieldset.querySelector<HTMLTextAreaElement>('[data-field="claim"]')?.value ?? "",
        accessedAt: fieldset.querySelector<HTMLInputElement>('[data-field="accessedAt"]')?.value ?? "",
        sourceType: (fieldset.querySelector<HTMLElement>('[data-field="sourceType"]') as EvidenceControl | null)?.value ?? "",
        firstParty: fieldset.querySelector<HTMLInputElement>('[data-field="firstParty"]')?.checked ?? false,
      })),
    };
  }

  function fieldForPath(path: string): EvidenceControl | undefined {
    const match = path.match(/^evidenceSources\.(\d+)\.(\w+)$/);
    if (!match) return undefined;
    return sourceFieldsets()[Number(match[1])]?.querySelector<HTMLElement>(`[data-field="${match[2]}"]`) as
      | EvidenceControl
      | undefined;
  }

  function showErrors(errors: SubmissionEvidenceError[]) {
    clearErrors();
    const summaryItems: HTMLLIElement[] = [];
    for (const error of errors) {
      const field = fieldForPath(error.path);
      const fieldName = error.path.split(".").at(-1);
      const errorElement = field?.closest<HTMLElement>(".evidence-field")?.querySelector<HTMLElement>(
        `[data-error-for="${fieldName}"]`,
      );
      if (field) field.setAttribute("aria-invalid", "true");
      if (errorElement) {
        errorElement.textContent = error.message;
        errorElement.hidden = false;
      }

      if (errorList) {
        const item = document.createElement("li");
        item.textContent = error.message;
        summaryItems.push(item);
      }
    }
    errorList?.replaceChildren(...summaryItems);

    if (errorSummary) {
      errorSummary.hidden = false;
      errorSummary.focus();
    }
  }

  function evidenceYaml(evidenceSources: SubmissionEvidenceSource[]) {
    return [
      "evidenceSources:",
      ...evidenceSources.flatMap((source) => [
        `  - title: ${JSON.stringify(source.title)}`,
        `    url: ${JSON.stringify(source.url)}`,
        `    claim: ${JSON.stringify(source.claim)}`,
        `    accessedAt: ${JSON.stringify(source.accessedAt)}`,
        `    sourceType: ${JSON.stringify(source.sourceType)}`,
      ]),
    ].join("\n");
  }

  addButton?.addEventListener("click", () => {
    if (!sourcesContainer || !sourceTemplate || sourceFieldsets().length >= MAX_EVIDENCE_SOURCES) return;
    sourcesContainer.insertAdjacentHTML("beforeend", sourceTemplate.innerHTML);
    updateSourceIndexes();
    clearErrors();
    invalidateSuccess();
    const fieldsets = sourceFieldsets();
    fieldsets.at(-1)?.querySelector<HTMLInputElement>('[data-field="title"]')?.focus();
    if (status) status.textContent = `Evidence source ${fieldsets.length} added.`;
  });

  sourcesContainer?.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const removeButton = target.closest<HTMLButtonElement>("[data-remove-source]");
    if (!removeButton || sourceFieldsets().length === 1) return;
    const fieldset = removeButton.closest<HTMLFieldSetElement>("[data-evidence-source]");
    const removedIndex = sourceFieldsets().indexOf(fieldset as HTMLFieldSetElement);
    fieldset?.remove();
    updateSourceIndexes();
    clearErrors();
    invalidateSuccess();
    const remaining = sourceFieldsets();
    remaining[Math.min(removedIndex, remaining.length - 1)]?.querySelector<HTMLInputElement>('[data-field="title"]')?.focus();
    if (status) status.textContent = `Evidence source removed. ${remaining.length} ${remaining.length === 1 ? "source remains" : "sources remain"}.`;
  });

  form?.addEventListener("input", () => {
    clearErrors();
    invalidateSuccess();
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearErrors();
    invalidateSuccess();

    const payload = collectPayload();
    const clientResult = validateSubmissionEvidence(payload);
    if (!clientResult.ok) {
      showErrors(clientResult.errors);
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Validating…";
    }

    try {
      const response = await fetch("/api/submission-evidence", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await response.json() as EvidenceApiResult;
      if (!result.ok) {
        showErrors(result.errors ?? [{ path: "evidenceSources", message: result.error ?? "Evidence could not be validated." }]);
        return;
      }
      if (!response.ok) {
        showErrors([{ path: "evidenceSources", message: "Evidence could not be validated." }]);
        return;
      }

      if (output) output.textContent = evidenceYaml(result.evidenceSources);
      if (success) {
        success.hidden = false;
        success.scrollIntoView({ block: "nearest" });
      }
    } catch {
      showErrors([{ path: "evidenceSources", message: "Evidence could not be validated. Check your connection and try again." }]);
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Validate required evidence";
      }
    }
  });

  copyButton?.addEventListener("click", async () => {
    const text = output?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      copyButton.textContent = "Copied";
      window.setTimeout(() => {
        copyButton.textContent = "Copy evidence block";
      }, 1200);
    } catch {
      output?.parentElement?.focus();
    }
  });

  updateSourceIndexes();
</script>
