---
import type { Category } from "../lib/content";
import { categoryHref } from "../lib/content";

interface Props {
  categories: Category[];
  currentCategorySlug?: string;
  includeOpenSource?: boolean;
  openSourceHref?: string;
  openSourceActive?: boolean;
}

const {
  categories,
  currentCategorySlug,
  includeOpenSource = true,
  openSourceHref = "/open-source-ai-agent-tools",
  openSourceActive = false,
} = Astro.props;
---

<nav class="chip-row" aria-label="Categories">
  <a class:list={["chip", !currentCategorySlug && !openSourceActive && "is-active"]} href="/">All</a>
  {
    categories.map((category) => (
      <a
        class:list={[
          "chip",
          currentCategorySlug === category.slug && "is-active",
        ]}
        href={categoryHref(category)}
      >
        {category.label}
      </a>
    ))
  }
  {
    includeOpenSource && (
      <a class:list={["chip", openSourceActive && "is-active"]} href={openSourceHref}>
        Open Source Repos
      </a>
    )
  }
</nav>
