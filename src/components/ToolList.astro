---
import type { ToolCardData } from "../lib/content";
import { toolHref } from "../lib/content";
import { formatClassification } from "../lib/classification";
import { buildToolSearchText } from "../lib/homepage-search";

interface Props {
  tools: ToolCardData[];
  emptyLabel?: string;
  searchable?: boolean;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
}

const {
  tools,
  emptyLabel = "No tools found.",
  searchable = false,
  headingLevel = 2,
} = Astro.props;

const HeadingTag = `h${headingLevel}` as "h2" | "h3" | "h4" | "h5" | "h6";
---

{
  tools.length === 0 ? (
    <div class="empty-state">{emptyLabel}</div>
  ) : (
    <div class="directory-list directory-list-workspace">
      {tools.map((tool) => (
        <article
          class="card card-workspace"
          data-category-slug={searchable ? tool.category.slug : undefined}
          data-search-text={
            searchable
              ? buildToolSearchText({
                  name: tool.entry.name,
                  description: tool.entry.description,
                  categoryLabel: tool.category.label,
                  tags: tool.entry.tags,
                })
              : undefined
          }
        >
          <a class="card-main card-main-workspace" href={toolHref(tool.entry)}>
              <div class="workspace-card-head">
                <div class="card-brand workspace-card-brand">
                  <div class="card-logo" aria-hidden="true">
                    {tool.entry.logoUrl ? (
                      <img
                        src={`/media/tools/${tool.entry.slug}/card`}
                        alt=""
                        width="44"
                        height="44"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span>{tool.entry.name.slice(0, 1)}</span>
                    )}
                  </div>

                  <div>
                    <p class="card-category">{tool.category.label}</p>
                    <HeadingTag class="card-title">{tool.entry.name}</HeadingTag>
                  </div>
                </div>
                {tool.entry.classification && (
                  <span class="classification-badge">
                    {formatClassification(tool.entry.classification)}
                  </span>
                )}
              </div>

              <p class="card-description">{tool.entry.description}</p>

              <div class="card-footer workspace-card-footer">
                {tool.entry.tags.length > 0 && (
                  <div class="tag-list">
                    {tool.entry.tags.map((tag) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
                <span class="card-license">{tool.pricingLabel}</span>
              </div>
            </a>
        </article>
      ))}
    </div>
  )
}
