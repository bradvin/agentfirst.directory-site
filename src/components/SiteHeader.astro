---
const navigationLinks = [
  { href: "/about", label: "About" },
  { href: "/research/state-of-agent-first-infrastructure", label: "Research" },
  { href: "/policy", label: "Policy" },
  { href: "/submit", label: "Submit" },
];
---

<header class="site-header">
  <div class="shell-inner header-inner">
    <a class="brand" href="/">
      <span>agent</span><span class="brand-accent">first</span><span>.directory</span>
    </a>

    <nav class="header-nav" aria-label="Primary">
      {navigationLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
    </nav>

    <details class="mobile-nav">
      <summary class="mobile-nav-toggle">
        <span class="visually-hidden">Menu</span>
        <span class="mobile-nav-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav class="mobile-nav-links" aria-label="Mobile primary">
        {navigationLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>
