---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryChips from "../components/CategoryChips.astro";
import HomepageSearch from "../components/HomepageSearch.astro";
import ToolList from "../components/ToolList.astro";
import { getHomepageData } from "../lib/content";
import { cacheControl, setCacheControl } from "../lib/cache";
import {
  homepageCollectionSchema,
  publisherSchema,
  schemaGraph,
  websiteSchema,
} from "../lib/seo";
import { siteConfig } from "../lib/site";

const { categories, tools: toolCards } = await getHomepageData();
setCacheControl(Astro.response.headers, cacheControl.homepage);

const structuredData = [
  schemaGraph(
    publisherSchema(),
    websiteSchema(),
    homepageCollectionSchema(toolCards, "/", {
      name: "AI Agent Tools Directory",
      description: siteConfig.description,
    }),
  ),
];
---

<BaseLayout
  title={`AI Agent Tools Directory | ${siteConfig.name}`}
  description={siteConfig.description}
  canonicalPath="/"
  structuredData={structuredData}
>
  <div class="shell-inner">
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-pill">
          <span class="pill-dot"></span>
          {toolCards.length} agent-first tools listed
        </p>

        <h1 class="hero-title">
          The directory for <span class="hero-accent">agent-first</span> AI tools
        </h1>

        <p class="hero-copy-text">
          {siteConfig.description}{" "}
          <span class="hero-policy-copy">
            Every listing has to pass the evidence-based inclusion test.{" "}
            <a class="detail-link" href="/policy">Read the inclusion policy →</a>
          </span>
        </p>
      </div>
    </section>

    <CategoryChips categories={categories} />

    <HomepageSearch total={toolCards.length} />

    <section class="section-block" data-homepage-results>
      <ToolList tools={toolCards} searchable />
    </section>
  </div>
</BaseLayout>
