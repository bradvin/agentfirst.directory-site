---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryFilters from "../components/CategoryFilters.astro";
import HomepageSearch from "../components/HomepageSearch.astro";
import ToolList from "../components/ToolList.astro";
import { getHomepageData } from "../lib/content";
import { cacheControl, setCacheControl } from "../lib/cache";
import {
  homepageCollectionSchema,
  publisherSchema,
  schemaGraph,
  websiteSchema,
} from "../lib/seo";
import { siteConfig } from "../lib/site";

const { categories, tools: toolCards } = await getHomepageData();
setCacheControl(Astro.response.headers, cacheControl.homepage);

const structuredData = [
  schemaGraph(
    publisherSchema(),
    websiteSchema(),
    homepageCollectionSchema(toolCards, "/", {
      name: "AI Agent Tools Directory",
      description: siteConfig.description,
    }),
  ),
];
---

<BaseLayout
  title={`AI Agent Tools Directory | ${siteConfig.name}`}
  description={siteConfig.description}
  canonicalPath="/"
  structuredData={structuredData}
  pageClass="homepage-workspace-page"
>
  <div class="shell-inner">
    <section class="homepage-intro">
      <div class="homepage-intro-copy">
        <p class="homepage-kicker">{toolCards.length} evidence-reviewed listings</p>
        <h1 class="homepage-title">
          The directory for <span class="hero-accent">agent-first</span> AI tools
        </h1>
        <p class="homepage-description">{siteConfig.description}</p>
      </div>
      <div class="homepage-intro-actions">
        <a class="button button-primary" href="/submit">Submit a tool</a>
        <a class="button button-secondary" href="/policy">Inclusion policy</a>
      </div>
    </section>

    <section class="homepage-workspace" aria-label="Tool directory">
      <CategoryFilters categories={categories} tools={toolCards} />
      <div class="homepage-directory">
        <HomepageSearch total={toolCards.length} />
        <section data-homepage-results aria-label="Directory results">
          <ToolList tools={toolCards} variant="workspace" searchable />
        </section>
      </div>
    </section>
  </div>
</BaseLayout>
