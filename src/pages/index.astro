---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryChips from "../components/CategoryChips.astro";
import HomepageSearch from "../components/HomepageSearch.astro";
import ToolList from "../components/ToolList.astro";
import { getHomepageData, toolHref } from "../lib/content";
import { cacheControl, setCacheControl } from "../lib/cache";
import { itemListSchema, websiteSchema } from "../lib/seo";
import { siteConfig } from "../lib/site";

const { categories, tools: toolCards } = await getHomepageData();
setCacheControl(Astro.response.headers, cacheControl.homepage);

const structuredData = [
  websiteSchema(),
  itemListSchema(
    toolCards.map((tool) => ({
      name: tool.entry.name,
      path: toolHref(tool.entry),
      description: tool.entry.description,
    })),
    "/",
  ),
];
---

<BaseLayout
  title={`${siteConfig.name} | The directory for agent-first tools`}
  description={siteConfig.description}
  canonicalPath="/"
  structuredData={structuredData}
>
  <div class="shell-inner">
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-pill">
          <span class="pill-dot"></span>
          {toolCards.length} agent-first tools listed
        </p>

        <h1 class="hero-title">
          The directory for <span class="hero-accent">agent-first</span> tools
        </h1>

        <p class="hero-copy-text">
          {siteConfig.description}.
          <span class="hero-policy-copy">
            Every listing must pass an evidence-based inclusion test.
            <a class="detail-link" href="/policy">Read the inclusion policy →</a>
          </span>
        </p>
      </div>
    </section>

    <CategoryChips categories={categories} includeOpenSource={false} />

    <HomepageSearch total={toolCards.length} />

    <section class="section-block" data-homepage-results>
      <ToolList tools={toolCards} searchable />
    </section>
  </div>
</BaseLayout>
