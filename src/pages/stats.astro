---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readPublicStats } from "../lib/public-stats";
import { siteConfig } from "../lib/site";
if (!["GET", "HEAD"].includes(Astro.request.method)) {
  return new Response(null, { status: 405, headers: { Allow: "GET, HEAD" } });
}
const snapshot = await readPublicStats(env.DB);
Astro.response.headers.set("Cache-Control", "public, max-age=300");
const description = "Public Cloudflare zone edge unique-visitor and HTTP request metrics, daily coverage, and measurement limitations for agentfirst.directory.";
const formatEstimate = (value: number | null) => value === null ? "Not reported" : new Intl.NumberFormat("en", { maximumFractionDigits: 2 }).format(value);
const available = snapshot.status !== "unavailable";
const statusLabel = { fresh: "Fresh snapshot", stale: "Stale snapshot", unavailable: "Statistics unavailable" }[snapshot.status];
const statusMessage = {
  fresh: "The latest successful snapshot is current. Freshness does not mean every date has reported data.",
  stale: "The last successful snapshot is shown, but it may be out of date. A refresh failed, the snapshot is over 36 hours old, or its reporting window is no longer current.",
  unavailable: "No usable edge traffic snapshot is available. Unavailable measurements are not zero traffic. Older browser/RUM snapshots are not compatible with this schema.",
}[snapshot.status];
const maxRequests = Math.max(1, ...snapshot.daily.map(d => d.requests ?? 0));
---
<BaseLayout title={`Public traffic statistics | ${siteConfig.name}`} description={description} canonicalPath="/stats">
  <div class="shell-inner policy-shell stats-shell">
    <section class="page-intro page-intro-centered">
      <p class="detail-overline">Public measurements</p>
      <h1 class="page-title">Website traffic statistics</h1>
      <p class="page-copy">Cloudflare zone edge metrics, matching the Overview source: unique visitors and HTTP requests, including bots, crawlers, and asset traffic. These are measurements of the website's proxied zone, not of the tools listed here or identifiable unique humans.</p>
      <p class="stats-json-link"><a class="detail-link" href="/stats.json">Read the machine-readable snapshot (JSON)</a></p>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="snapshot-heading">
      <p class="detail-overline">Snapshot status</p>
      <h2 id="snapshot-heading">{statusLabel}</h2>
      <p>{statusMessage}</p>
      <dl class="stats-metadata">
        <div><dt>Reporting window</dt><dd><time datetime={snapshot.period.start}>{snapshot.period.start}</time> through <time datetime={snapshot.period.end}>{snapshot.period.end}</time> (inclusive), {snapshot.period.days} complete dates in {snapshot.period.timezone}</dd></div>
        <div><dt>Last successful refresh</dt><dd>{snapshot.refreshedAt ? <time datetime={snapshot.refreshedAt}>{snapshot.refreshedAt} (UTC)</time> : "No successful refresh available"}</dd></div>
        <div><dt>Coverage</dt><dd>{snapshot.coverage.reportedDays} reported dates; {snapshot.coverage.missingDays} missing dates. {snapshot.coverage.sampled ? "Sampling indicated in daily detail." : "No sampling indicated in daily detail; this does not establish aggregate sampling."}</dd></div>
      </dl>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="estimates-heading">
      <p class="detail-overline">{available ? "Full-window API aggregate" : "No measurements available"}</p>
      <h2 id="estimates-heading">{available ? "Traffic reported in this window" : "Traffic measurements unavailable"}</h2>
      <div class="stats-estimates">
        <dl><dt>Unique visitors</dt><dd>{available ? formatEstimate(snapshot.totals.uniqueVisitors) : "Unavailable"}</dd></dl>
        <dl><dt>HTTP requests</dt><dd>{available ? formatEstimate(snapshot.totals.requests) : "Unavailable"}</dd></dl>
      </div>
      <p>{available ? "Totals are returned by one whole-window API query, independent of daily coverage. Unique visitors are not unique humans; cross-day IP deduplication is not established. These are provider metrics, not an exact census of people." : "No edge measurements are available. Missing measurements are not treated as zero, and browser metrics are never substituted."}</p>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="daily-heading">
      <p class="detail-overline">Daily detail</p>
      <h2 id="daily-heading">All {snapshot.period.days} reporting dates</h2>
      <p id="daily-help">Dates are UTC. Daily unique visitors are not additive. A reported 0 is the provider's measurement, not proof of no actual traffic when sampled; “Not reported” means missing data, not zero. On narrow screens, focus the table region and use the arrow keys to scroll.</p>
      <figure class="stats-chart" aria-labelledby="chart-caption">
        <figcaption id="chart-caption">Daily HTTP requests; gaps are missing measurements. Exact values follow in the table.</figcaption>
        <div class="stats-bars" aria-hidden="true">{snapshot.daily.map(day => <div class:list={["stats-bar-slot", { "stats-missing": day.requests === null }]}><span style={`height:${day.requests === null ? 0 : 100 * day.requests / maxRequests}%`}></span></div>)}</div>
      </figure>
      <div class="stats-table-scroll" role="region" tabindex="0" aria-label="Daily traffic estimates, horizontally scrollable" aria-describedby="daily-help">
        <table>
          <caption>Daily unique visitors and HTTP requests, {snapshot.period.start} through {snapshot.period.end} (UTC)</caption>
          <thead><tr><th scope="col">Date (UTC)</th><th scope="col" class="stats-numeric">Unique visitors (daily)</th><th scope="col" class="stats-numeric">HTTP requests</th><th scope="col" class="stats-numeric">Sample interval</th></tr></thead>
          <tbody>{snapshot.daily.map(day => <tr><th scope="row"><time datetime={day.date}>{day.date}</time></th><td class="stats-numeric">{formatEstimate(day.uniqueVisitors)}</td><td class="stats-numeric">{formatEstimate(day.requests)}</td><td class="stats-numeric">{formatEstimate(day.sampleInterval)}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="methodology-heading">
      <p class="detail-overline">Definitions and limitations</p>
      <h2 id="methodology-heading">What these numbers mean</h2>
      <dl class="stats-metadata">
        <div><dt>Source</dt><dd>{snapshot.source.name}, dataset <code>{snapshot.source.dataset}</code>.</dd></div>
        <div><dt>Unique visitors</dt><dd>Provider-defined unique visitors from <code>{snapshot.source.metrics.uniqueVisitors}</code>. This network/IP-based metric includes bots and crawlers, not identifiable unique humans.</dd></div>
        <div><dt>HTTP requests</dt><dd>Provider HTTP requests from <code>{snapshot.source.metrics.requests}</code>, including network and asset traffic, not page views.</dd></div>
        <div><dt>Sampling</dt><dd>The sample interval is provider-reported daily metadata, not a percentage. Counts are used as returned; we do not multiply them by the interval again.</dd></div>
      </dl>
      <p>Zone scope covers all Cloudflare-proxied hostnames in the configured zone. No hostname, bot, or eyeball-only filter is applied. These measurements cannot distinguish human visitors from AI agents.</p>
      <ul class="stats-caveats">{snapshot.source.caveats.map(caveat => <li>{caveat}</li>)}</ul>
      <p>Use the <a class="detail-link" href="/stats.json">public JSON snapshot</a> for the same dates, metrics, coverage, and source caveats.</p>
    </section>
  </div>
</BaseLayout>
<style>
  .stats-shell { min-width: 0; }
  .stats-json-link { margin: 18px 0 0; }
  .stats-metadata { display: grid; gap: 16px; margin: 0; }
  .stats-metadata div { min-width: 0; }
  .stats-metadata dt, .stats-estimates dt { color: var(--text); font-weight: 600; }
  .stats-metadata dd { margin: 4px 0 0; color: var(--muted-soft); line-height: 1.65; overflow-wrap: anywhere; }
  .stats-estimates { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .stats-estimates dl { margin: 0; }
  .stats-estimates dd { margin: 8px 0 0; color: var(--accent); font: 600 clamp(1.35rem, 4vw, 2rem) "IBM Plex Mono", monospace; overflow-wrap: anywhere; }
  .stats-chart { margin: 0 0 24px; }
  .stats-chart figcaption { color: var(--muted-soft); line-height: 1.65; margin-bottom: 12px; }
  .stats-bars { display: grid; grid-template-columns: repeat(30, minmax(0, 1fr)); gap: 3px; height: 130px; border-bottom: 1px solid var(--border); }
  .stats-bar-slot { display: flex; align-items: end; min-width: 0; }
  .stats-bar-slot span { width: 100%; background: var(--accent); }
  .stats-missing { border-bottom: 2px dashed var(--muted-soft); }
  .stats-table-scroll { min-width: 0; max-width: 100%; overflow-x: auto; border: 1px solid var(--border); border-radius: 4px; }
  .stats-table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  table { width: 100%; min-width: 610px; border-collapse: collapse; font-size: 14px; }
  caption { padding: 14px; text-align: left; color: var(--muted-soft); line-height: 1.6; }
  th, td { padding: 12px 14px; text-align: left; border-top: 1px solid var(--border); }
  thead th { background: var(--surface-strong); }
  tbody th { font-weight: 400; white-space: nowrap; }
  .stats-numeric { text-align: right; font-variant-numeric: tabular-nums; }
  .stats-caveats { margin: 0; padding-left: 22px; color: var(--muted-soft); line-height: 1.65; }
  .stats-caveats li + li { margin-top: 8px; }
  @media (max-width: 480px) { .stats-estimates { grid-template-columns: 1fr; } }
</style>
