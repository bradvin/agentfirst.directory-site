---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readPublicStats } from "../lib/public-stats";
import { siteConfig } from "../lib/site";
if (!["GET", "HEAD"].includes(Astro.request.method)) {
  return new Response(null, { status: 405, headers: { Allow: "GET, HEAD" } });
}
const snapshot = await readPublicStats(env.DB);
Astro.response.headers.set("Cache-Control", "public, max-age=300");
const description = "Website traffic over the last 30 complete days, with unique visitors, HTTP requests and daily figures for agentfirst.directory.";
const formatEstimate = (value: number | null) => value === null ? "Not reported" : new Intl.NumberFormat("en", { maximumFractionDigits: 2 }).format(value);
const formatDate = (value: string) => new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(value));
const formatUpdate = (value: string) => `${formatDate(value)}, ${new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", hourCycle: "h23", timeZone: "UTC" }).format(new Date(value))} UTC`;
const available = snapshot.status !== "unavailable";
const statusLabel = { fresh: "Fresh snapshot", stale: "Stale snapshot", unavailable: "Statistics unavailable" }[snapshot.status];
const statusMessage = {
  fresh: "The latest update is current, though some daily figures may be missing.",
  stale: "These figures are from the last successful update and may be out of date.",
  unavailable: "Traffic figures are not available right now. Missing figures do not mean zero traffic.",
}[snapshot.status];
const maxRequests = Math.max(1, ...snapshot.daily.map(d => d.requests ?? 0));
---
<BaseLayout title={`Public traffic statistics | ${siteConfig.name}`} description={description} canonicalPath="/stats">
  <div class="shell-inner policy-shell stats-shell">
    <section class="page-intro page-intro-centered">
      <p class="detail-overline">Public measurements</p>
      <h1 class="page-title">Website traffic statistics</h1>
      <p class="page-copy">A summary of website traffic, including bots and automated visits.</p>
      <p class="stats-json-link"><a class="detail-link" href="/stats.json">Read the detailed figures (JSON)</a></p>
    </section>
    <section class="stats-summary" aria-label="Traffic summary">
      <article class="stats-summary-card detail-panel policy-panel" aria-labelledby="visitors-heading">
        <h2 id="visitors-heading">Unique visitors</h2>
        <p class="stats-value">{available ? formatEstimate(snapshot.totals.uniqueVisitors) : "Unavailable"}</p>
        <p class="stats-card-copy">A visitor estimate that includes bots and automated traffic.</p>
      </article>
      <article class="stats-summary-card detail-panel policy-panel" aria-labelledby="requests-heading">
        <h2 id="requests-heading">HTTP Requests</h2>
        <p class="stats-value">{available ? formatEstimate(snapshot.totals.requests) : "Unavailable"}</p>
        <p class="stats-card-copy">Requests for pages, images and other files.</p>
      </article>
      <article class="stats-summary-card detail-panel policy-panel" aria-labelledby="window-heading">
        <h2 id="window-heading">Window</h2>
        <p class="stats-value">Last 30 days</p>
        <p class="stats-card-copy">30 complete days in UTC, not including today.</p>
        <p class="stats-window-dates"><time datetime={snapshot.period.start}>{formatDate(snapshot.period.start)}</time> to <time datetime={snapshot.period.end}>{formatDate(snapshot.period.end)}</time></p>
      </article>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="daily-heading">
      <p class="detail-overline">Daily detail</p>
      <h2 id="daily-heading">Traffic by day</h2>
      <p id="daily-help">Days use UTC. “Not reported” means missing data, not zero. On small screens, focus the table and use the arrow keys to scroll.</p>
      <figure class="stats-chart" aria-labelledby="chart-caption">
        <figcaption id="chart-caption">Daily HTTP requests. Gaps mean missing figures; values are in the table below.</figcaption>
        <div class="stats-bars" aria-hidden="true">{snapshot.daily.map(day => <div class:list={["stats-bar-slot", { "stats-missing": day.requests === null }]}><span style={`height:${day.requests === null ? 0 : 100 * day.requests / maxRequests}%`}></span></div>)}</div>
      </figure>
      <div class="stats-table-scroll" role="region" tabindex="0" aria-label="Daily traffic estimates, horizontally scrollable" aria-describedby="daily-help">
        <table>
          <caption>Daily unique visitors and HTTP requests, <time datetime={snapshot.period.start}>{formatDate(snapshot.period.start)}</time> to <time datetime={snapshot.period.end}>{formatDate(snapshot.period.end)}</time> (UTC)</caption>
          <thead><tr><th scope="col">Date (UTC)</th><th scope="col" class="stats-numeric">Unique visitors</th><th scope="col" class="stats-numeric">HTTP requests</th></tr></thead>
          <tbody>{snapshot.daily.map(day => <tr><th scope="row"><time datetime={day.date}>{formatDate(day.date)}</time></th><td class="stats-numeric">{formatEstimate(day.uniqueVisitors)}</td><td class="stats-numeric">{formatEstimate(day.requests)}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="methodology-heading">
      <p class="detail-overline">Definitions</p>
      <h2 id="methodology-heading">What these numbers mean</h2>
      <dl class="stats-metadata">
        <div><dt>Unique visitors</dt><dd>This is not an exact count of people: bots and automated traffic are included. Do not add daily visitors to get the total shown above.</dd></div>
        <div><dt>HTTP requests</dt><dd>These include pages, images and other files, not page views.</dd></div>
        <div><dt>Sampling</dt><dd><p>Some traffic figures may be estimated from a sample rather than every request, so treat them as a guide rather than an exact count.</p></dd></div>
      </dl>
      <p>More measurement details are in the <a class="detail-link" href="/stats.json">JSON snapshot</a>.</p>
    </section>
    <section class="detail-panel policy-panel" aria-labelledby="snapshot-heading">
      <p class="detail-overline">Snapshot status</p>
      <h2 id="snapshot-heading">{statusLabel}</h2>
      <p>{statusMessage}</p>
      <dl class="stats-metadata">
        <div><dt>Reporting dates</dt><dd><time datetime={snapshot.period.start}>{formatDate(snapshot.period.start)}</time> to <time datetime={snapshot.period.end}>{formatDate(snapshot.period.end)}</time> (UTC)</dd></div>
        <div><dt>Last update</dt><dd>{snapshot.refreshedAt ? <time datetime={snapshot.refreshedAt}>{formatUpdate(snapshot.refreshedAt)}</time> : "No successful update yet"}</dd></div>
        <div><dt>Daily coverage</dt><dd>{snapshot.coverage.reportedDays} days reported; {snapshot.coverage.missingDays} days not reported. Totals are reported separately from the daily figures.</dd></div>
      </dl>
    </section>
  </div>
</BaseLayout>
<style>
  .stats-shell { min-width: 0; }
  .stats-json-link { margin: 18px 0 0; }
  .stats-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .stats-summary-card { min-width: 0; }
  .stats-summary-card h2 { margin: 0; font-size: 1.05rem; }
  .stats-value { margin: 12px 0; color: var(--accent); font: 600 clamp(1.35rem, 2vw, 2rem) "IBM Plex Mono", monospace; overflow-wrap: anywhere; }
  .stats-card-copy, .stats-window-dates { margin: 0; color: var(--muted-soft); line-height: 1.65; }
  .stats-window-dates { margin-top: 12px; font-size: 0.875rem; }
  .stats-metadata { display: grid; gap: 16px; margin: 0; }
  .stats-metadata div { min-width: 0; }
  .stats-metadata dt { color: var(--text); font-weight: 600; }
  .stats-metadata dd { margin: 4px 0 0; color: var(--muted-soft); line-height: 1.65; overflow-wrap: anywhere; }
  .stats-metadata dd p { margin: 0; }
  .stats-chart { margin: 0 0 24px; }
  .stats-chart figcaption { color: var(--muted-soft); line-height: 1.65; margin-bottom: 12px; }
  .stats-bars { display: grid; grid-template-columns: repeat(30, minmax(0, 1fr)); gap: 3px; height: 130px; border-bottom: 1px solid var(--border); }
  .stats-bar-slot { display: flex; align-items: end; min-width: 0; }
  .stats-bar-slot span { width: 100%; background: var(--accent); }
  .stats-missing { border-bottom: 2px dashed var(--muted-soft); }
  .stats-table-scroll { min-width: 0; max-width: 100%; overflow-x: auto; border: 1px solid var(--border); border-radius: 4px; }
  .stats-table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  table { width: 100%; min-width: 540px; border-collapse: collapse; font-size: 14px; }
  caption { padding: 14px; text-align: left; color: var(--muted-soft); line-height: 1.6; }
  th, td { padding: 12px 14px; text-align: left; border-top: 1px solid var(--border); }
  thead th { background: var(--surface-strong); }
  tbody th { font-weight: 400; white-space: nowrap; }
  .stats-numeric { text-align: right; font-variant-numeric: tabular-nums; }
  @media (max-width: 720px) { .stats-summary { grid-template-columns: 1fr; } }
</style>
