---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryChips from "../../components/CategoryChips.astro";
import ToolList from "../../components/ToolList.astro";
import {
  getSortedCategories,
  getSortedTools,
  toToolCards,
  toolHref,
  type CategoryEntry,
} from "../../lib/content";
import { breadcrumbSchema, collectionPageSchema } from "../../lib/seo";
import { siteConfig } from "../../lib/site";

export async function getStaticPaths() {
  const categories = await getSortedCategories();
  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category },
  }));
}

const { category } = Astro.props as { category: CategoryEntry };
const categories = await getSortedCategories();
const allTools = await getSortedTools();
const tools = await toToolCards(
  allTools.filter((tool) => tool.data.category.id === category.id),
);
const path = `/category/${category.data.slug}`;
const description = `Browse approved ${category.data.label.toLowerCase()} tools built for agent-first workflows.`;
const structuredData = [
  breadcrumbSchema([
    { name: siteConfig.shortName, path: "/" },
    { name: category.data.label, path },
  ]),
  collectionPageSchema(category, tools, path),
];
---

<BaseLayout
  title={`${category.data.label} tools | ${siteConfig.name}`}
  description={description}
  canonicalPath={path}
  structuredData={structuredData}
>
  <div class="shell-inner">
    <section class="page-intro page-intro-centered">
      <p class="detail-overline">Category</p>
      <h1 class="page-title">{category.data.label}</h1>
      <p class="page-copy">{description}</p>
    </section>

    <CategoryChips
      categories={categories}
      currentCategorySlug={category.data.slug}
      includeOpenSource={false}
    />

    <section class="section-block">
      <div class="section-heading">
        <div>
          <p class="detail-overline">Category listing</p>
          <h2>{tools.length} approved tools</h2>
        </div>
      </div>
      <ToolList tools={tools} emptyLabel="No approved tools in this category yet." />
    </section>
  </div>
</BaseLayout>
