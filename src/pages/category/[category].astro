---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryChips from "../../components/CategoryChips.astro";
import NotFoundState from "../../components/NotFoundState.astro";
import ToolList from "../../components/ToolList.astro";
import {
  getCategories,
  getCategoryBySlug,
  getToolsByCategory,
} from "../../lib/content";
import { cacheControl, setCacheControl } from "../../lib/cache";
import { breadcrumbSchema, collectionPageSchema } from "../../lib/seo";
import { siteConfig } from "../../lib/site";

const categorySlug = Astro.params.category ?? "";
const [categories, category] = await Promise.all([
  getCategories(),
  getCategoryBySlug(categorySlug),
]);
const tools = category ? await getToolsByCategory(category.slug) : [];
const path = category ? `/category/${category.slug}` : Astro.url.pathname;
const description = category
  ? `Browse approved ${category.label.toLowerCase()} tools built for agent-first workflows.`
  : "The requested category does not exist in the approved directory.";

if (!category) {
  Astro.response.status = 404;
} else {
  setCacheControl(Astro.response.headers, cacheControl.category);
}

const structuredData = category
  ? [
      breadcrumbSchema([
        { name: siteConfig.shortName, path: "/" },
        { name: category.label, path },
      ]),
      collectionPageSchema(category, tools, path),
    ]
  : [];
---

<BaseLayout
  title={category ? `${category.label} tools | ${siteConfig.name}` : `Not found | ${siteConfig.name}`}
  description={description}
  canonicalPath={path}
  structuredData={structuredData}
>
  <div class="shell-inner">
    {
      category ? (
        <>
          <section class="page-intro page-intro-centered">
            <p class="detail-overline">Category</p>
            <h1 class="page-title">{category.label}</h1>
            <p class="page-copy">{description}</p>
          </section>

          <CategoryChips
            categories={categories}
            currentCategorySlug={category.slug}
            includeOpenSource={false}
          />

          <section class="section-block">
            <div class="section-heading">
              <div>
                <p class="detail-overline">Category listing</p>
                <h2>{tools.length} {category.label} Tools</h2>
              </div>
            </div>
            <ToolList tools={tools} emptyLabel="No approved tools in this category yet." />
          </section>
        </>
      ) : (
        <NotFoundState />
      )
    }
  </div>
</BaseLayout>
