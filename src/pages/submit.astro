---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../lib/seo";
import { siteConfig } from "../lib/site";

const path = "/submit";
const title = `Submit a tool | ${siteConfig.name}`;
const description = "Ask your agent to research a tool and open an evidence-backed pull request.";
const contentRepoUrl = "https://github.com/bradvin/agentfirst.directory";
const skillUrl = "https://agentfirst.directory/SKILL.md";
const skillCopyText = "Read https://agentfirst.directory/SKILL.md to add a new tool";

const structuredData = [
  breadcrumbSchema([
    { name: siteConfig.shortName, path: "/" },
    { name: "Submit", path },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  structuredData={structuredData}
>
  <div class="shell-inner submit-shell">
    <section class="page-intro page-intro-centered">
      <p class="detail-overline">Submit</p>
      <h1 class="page-title">Add a tool with your agent</h1>
      <p class="page-copy">{description}</p>
    </section>

    <section class="detail-panel submit-panel submit-skill-panel">
      <header class="submit-section-header">
        <p class="detail-overline">Start here</p>
        <h2 class="submit-title">Give your agent the instructions</h2>
        <p class="submit-skill-lead">
          Copy this prompt into your coding agent and tell it which tool to add. The
          <a class="detail-link" href={skillUrl}>contribution skill</a> explains the policy, content format,
          evidence requirements, and pull request workflow.
        </p>
      </header>

      <div class="submit-skill-copy-row">
        <input
          id="skill-copy-input"
          class="submit-skill-input"
          type="text"
          readonly
          value={skillCopyText}
          aria-label="Skill file prompt"
        />
        <button
          id="skill-copy-button"
          class="button button-primary submit-skill-button"
          type="button"
          data-copy-text={skillCopyText}
        >
          Copy
        </button>
      </div>
      <p class="submit-copy">Include the tool name and its official website when you send the prompt.</p>
    </section>

    <section class="detail-panel submit-panel">
      <p class="detail-overline">Agent workflow</p>
      <h2 class="submit-title">What happens next</h2>
      <ol class="submit-steps">
        <li>The agent checks existing listings and the <a class="detail-link" href="/policy">inclusion policy</a>.</li>
        <li>It researches first-party sources, records the claims they support, and prepares the tool entry.</li>
        <li>It opens a pull request in the <a class="detail-link" href={contentRepoUrl} rel="noreferrer" target="_blank">content repository</a>.</li>
      </ol>
      <p class="submit-copy">
        The content repository checks the file format and required evidence. Editors review whether the sources
        are first-party, support the claims, and establish directory eligibility before accepting a listing.
      </p>
    </section>
  </div>

  <script>
    const copyButton = document.querySelector("#skill-copy-button");
    const copyInput = document.querySelector("#skill-copy-input");

    copyButton?.addEventListener("click", async () => {
      const text = copyButton.getAttribute("data-copy-text") ?? "";

      try {
        await navigator.clipboard.writeText(text);
        if (copyInput instanceof HTMLInputElement) {
          copyInput.select();
        }
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy";
        }, 1200);
      } catch {
        if (copyInput instanceof HTMLInputElement) {
          copyInput.focus();
          copyInput.select();
        }
      }
    });
  </script>
</BaseLayout>
