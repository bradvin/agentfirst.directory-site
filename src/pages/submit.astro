---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../lib/seo";
import { siteConfig } from "../lib/site";

const path = "/submit";
const title = `Submit a tool | ${siteConfig.name}`;
const description = "Ask your agent to research a tool and open an evidence-backed pull request.";
const contentRepoUrl = "https://github.com/bradvin/agentfirst.directory";
const skillUrl = "https://agentfirst.directory/SKILL.md";
const skillCopyText = "Read https://agentfirst.directory/SKILL.md to add a new tool";

const structuredData = [
  breadcrumbSchema([
    { name: siteConfig.shortName, path: "/" },
    { name: "Submit", path },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  structuredData={structuredData}
>
  <div class="shell-inner submit-shell">
    <section class="page-intro page-intro-centered">
      <p class="detail-overline">Submit</p>
      <h1 class="page-title">Add a tool with your agent</h1>
      <p class="page-copy">{description}</p>
      <p class="submit-copy">Submission review and publishing remain paused. This policy update does not restart them
        or activate the installed reviewer. The prompt tools below remain available for preparation only; do not
        open a new listing-submission PR while the pause is in effect.</p>
    </section>

    <section class="detail-panel submit-panel submit-skill-panel">
      <header class="submit-section-header">
        <p class="detail-overline">Start here</p>
        <h2 class="submit-title">Give your agent the instructions</h2>
        <p class="submit-skill-lead">
          Copy this prompt into your coding agent and tell it which tool to add. The{" "}
          <a class="detail-link" href={skillUrl}>contribution skill</a> explains the policy, content format,
          evidence requirements, and pull request workflow.
        </p>
      </header>

      <div class="submit-announcement-field">
        <label for="announcement-x-handle">X handle to tag when we announce your listing (optional)</label>
        <input
          id="announcement-x-handle"
          class="submit-skill-input"
          type="text"
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          aria-describedby="announcement-x-help announcement-x-error"
          aria-invalid="false"
        />
        <p id="announcement-x-help" class="submit-copy">Your personal or product account. Leave blank if you don’t want a tag.</p>
        <p id="announcement-x-error" role="alert" hidden></p>
      </div>

      <div class="submit-skill-copy-row">
        <input
          id="skill-copy-input"
          class="submit-skill-input"
          type="text"
          readonly
          value={skillCopyText}
          aria-label="Skill file prompt"
        />
        <button
          id="skill-copy-button"
          class="button button-primary submit-skill-button"
          type="button"
          data-copy-text={skillCopyText}
        >
          Copy
        </button>
      </div>
      <p class="submit-copy">Include the tool name and its official website when you send the prompt.</p>
    </section>

    <section class="detail-panel submit-panel" aria-labelledby="submit-fit-title">
      <p class="detail-overline">Eligibility</p>
      <h2 id="submit-fit-title" class="submit-title">Check the fit</h2>
      <p class="submit-copy">First identify a maintained offering and exact mode. It must qualify through Run
        (agents run with meaningful customer control), Equip (a concrete agent task or improvement through named
        purpose-built features), or Enable (an agent-first shared interoperability contract). Equip includes
        human-operated context, feedback, collaboration, maintained libraries, connectors and data tools; owning
        execution or infrastructure is not required. These routes are separate from the classifications below.
        A fit pass is not acceptance: first-party evidence and full review follow.</p>
      <div class="submit-grid">
        <div class="detail-panel submit-fields-panel">
          <div class="submit-field"><code>agent-native</code><span>Agents are a core actor, runtime, or participant.</span></div>
          <div class="submit-field"><code>agent-enabling</code><span>The product materially enables an agent-first workflow.</span></div>
          <div class="submit-field"><code>agent-internet-protocol</code><span>An open protocol lets agents communicate, transact, identify, or coordinate online.</span></div>
        </div>
        <div class="detail-panel submit-fields-panel">
          <div class="submit-field"><strong>Show the outcome</strong><span>Explain what an agent or agent builder can do because this exists.</span></div>
          <div class="submit-field"><strong>Cite the source</strong><span>Use maintained product docs, a repository, a specification, or an official page.</span></div>
          <div class="submit-field"><strong>Check the substance</strong><span>Generic API compatibility, a thin wrapper, or unsupported marketing is insufficient.</span></div>
        </div>
      </div>
      <p class="submit-copy">The <a class="detail-link" href="/policy">full inclusion policy</a> explains the decision in more detail.</p>
    </section>

    <section class="detail-panel submit-panel" aria-labelledby="submit-workflow-title">
      <p class="detail-overline">Agent workflow</p>
      <h2 id="submit-workflow-title" class="submit-title">What your agent prepares</h2>
      <div class="submit-grid">
        <ol class="submit-steps">
          <li>Checks for duplicates and applies the <a class="detail-link" href="/policy#inclusion-test">bounded positioning test</a> before evidence.
            Records pass-fit, fail-fit or unclear-fit; failed or unclear fit stops with evidence not reviewed.</li>
          <li>Only after pass-fit, researches claims, chooses an existing category when possible, and selects one evidence-backed classification.</li>
          <li>Maps material claims to dated first-party sources. It includes product facts only when verified and states limitations or unknowns.</li>
          <li>After the owner explicitly restarts submissions, opens a pull request in the <a class="detail-link" href={contentRepoUrl} rel="noreferrer" target="_blank">content repository</a>. A policy pass is not publication approval.</li>
        </ol>
        <div class="detail-panel submit-fact-panel">
          <p class="detail-overline">After the PR</p>
          <div class="submit-facts">
            <div class="submit-fact"><strong>Content checks</strong><span>CI validates the file format, category, and required evidence.</span></div>
            <div class="submit-fact"><strong>Editorial review</strong><span>Editors verify source ownership, claim support, and directory eligibility.</span></div>
            <div class="submit-fact"><strong>Publishing details</strong><span>The agent records GitHub author attribution. Repository automation may fill missing logo and social preview metadata.</span></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    import { announcementXHandleError, buildSubmissionPrompt } from "../lib/announcement-x-handle";

    const copyButton = document.querySelector("#skill-copy-button");
    const copyInput = document.querySelector("#skill-copy-input");
    const handleInput = document.querySelector("#announcement-x-handle");
    const handleError = document.querySelector("#announcement-x-error");
    let revision = 0;
    let resetTimer: number | undefined;

    function updatePrompt(): string | undefined {
      if (!(handleInput instanceof HTMLInputElement) || !copyButton || !handleError) return;
      window.clearTimeout(resetTimer);
      copyButton.textContent = "Copy";
      try {
        const text = buildSubmissionPrompt(handleInput.value);
        handleInput.setAttribute("aria-invalid", "false");
        handleError.textContent = "";
        handleError.setAttribute("hidden", "");
        if (copyInput instanceof HTMLInputElement) copyInput.value = text;
        copyButton.setAttribute("data-copy-text", text);
        return text;
      } catch {
        handleInput.setAttribute("aria-invalid", "true");
        handleError.textContent = announcementXHandleError;
        handleError.removeAttribute("hidden");
        // Never leave a previous valid handle available for copying after an invalid edit.
        if (copyInput instanceof HTMLInputElement) copyInput.value = "";
        copyButton.setAttribute("data-copy-text", "");
      }
    }

    handleInput?.addEventListener("input", () => {
      revision += 1;
      updatePrompt();
    });

    copyButton?.addEventListener("click", async () => {
      const text = updatePrompt();
      if (text === undefined) {
        if (handleInput instanceof HTMLInputElement) handleInput.focus();
        return;
      }
      const copiedRevision = revision;

      try {
        await navigator.clipboard.writeText(text);
        if (copiedRevision !== revision) return;
        if (copyInput instanceof HTMLInputElement) {
          copyInput.select();
        }
        copyButton.textContent = "Copied";
        resetTimer = window.setTimeout(() => {
          copyButton.textContent = "Copy";
        }, 1200);
      } catch {
        if (copiedRevision !== revision) return;
        if (copyInput instanceof HTMLInputElement) {
          copyInput.focus();
          copyInput.select();
        }
      }
    });
  </script>
</BaseLayout>
