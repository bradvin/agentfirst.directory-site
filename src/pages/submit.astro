---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../lib/seo";
import { siteConfig } from "../lib/site";

const path = "/submit";
const title = `Submit a tool | ${siteConfig.name}`;
const description = "Ask your agent to research a tool and open an evidence-backed pull request.";
const contentRepoUrl = "https://github.com/bradvin/agentfirst.directory";
const skillUrl = "https://agentfirst.directory/SKILL.md";
const skillCopyText = "Read https://agentfirst.directory/SKILL.md to add a new tool";

const structuredData = [
  breadcrumbSchema([
    { name: siteConfig.shortName, path: "/" },
    { name: "Submit", path },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={path}
  structuredData={structuredData}
>
  <div class="shell-inner submit-shell">
    <section class="page-intro page-intro-centered">
      <p class="detail-overline">Submit</p>
      <h1 class="page-title">Add a tool with your agent</h1>
      <p class="page-copy">{description}</p>
    </section>

    <section class="detail-panel submit-panel submit-skill-panel">
      <header class="submit-section-header">
        <p class="detail-overline">Start here</p>
        <h2 class="submit-title">Give your agent the instructions</h2>
        <p class="submit-skill-lead">
          Copy this prompt into your coding agent and tell it which tool to add. The{" "}
          <a class="detail-link" href={skillUrl}>contribution skill</a> explains the policy, content format,
          evidence requirements, and pull request workflow.
        </p>
      </header>

      <div class="submit-skill-copy-row">
        <input
          id="skill-copy-input"
          class="submit-skill-input"
          type="text"
          readonly
          value={skillCopyText}
          aria-label="Skill file prompt"
        />
        <button
          id="skill-copy-button"
          class="button button-primary submit-skill-button"
          type="button"
          data-copy-text={skillCopyText}
        >
          Copy
        </button>
      </div>
      <p class="submit-copy">Include the tool name and its official website when you send the prompt.</p>
    </section>

    <section class="detail-panel submit-panel" aria-labelledby="submit-fit-title">
      <p class="detail-overline">Eligibility</p>
      <h2 id="submit-fit-title" class="submit-title">Check the fit</h2>
      <p class="submit-copy">A listing needs a concrete agent role supported by first-party evidence. It must fit one of three classifications:</p>
      <div class="submit-grid">
        <div class="detail-panel submit-fields-panel">
          <div class="submit-field"><code>agent-native</code><span>Agents are a core actor, runtime, or participant.</span></div>
          <div class="submit-field"><code>agent-enabling</code><span>The product materially enables an agent-first workflow.</span></div>
          <div class="submit-field"><code>agent-internet-protocol</code><span>An open protocol lets agents communicate, transact, identify, or coordinate online.</span></div>
        </div>
        <div class="detail-panel submit-fields-panel">
          <div class="submit-field"><strong>Show the outcome</strong><span>Explain what an agent or agent builder can do because this exists.</span></div>
          <div class="submit-field"><strong>Cite the source</strong><span>Use maintained product docs, a repository, a specification, or an official page.</span></div>
          <div class="submit-field"><strong>Check the substance</strong><span>Generic API compatibility, a thin wrapper, or unsupported marketing is insufficient.</span></div>
        </div>
      </div>
      <p class="submit-copy">The <a class="detail-link" href="/policy">full inclusion policy</a> explains the decision in more detail.</p>
    </section>

    <section class="detail-panel submit-panel" aria-labelledby="submit-workflow-title">
      <p class="detail-overline">Agent workflow</p>
      <h2 id="submit-workflow-title" class="submit-title">What your agent prepares</h2>
      <div class="submit-grid">
        <ol class="submit-steps">
          <li>Checks existing listings and chooses a category. It proposes a new category only when none fits.</li>
          <li>Explains the concrete agent outcome and chooses one evidence-backed classification.</li>
          <li>Maps material claims to dated first-party sources. It includes product facts only when verified and states limitations or unknowns.</li>
          <li>Opens a pull request in the <a class="detail-link" href={contentRepoUrl} rel="noreferrer" target="_blank">content repository</a>.</li>
        </ol>
        <div class="detail-panel submit-fact-panel">
          <p class="detail-overline">After the PR</p>
          <div class="submit-facts">
            <div class="submit-fact"><strong>Content checks</strong><span>CI validates the file format, category, and required evidence.</span></div>
            <div class="submit-fact"><strong>Editorial review</strong><span>Editors verify source ownership, claim support, and directory eligibility.</span></div>
            <div class="submit-fact"><strong>Publishing details</strong><span>The agent records GitHub author attribution. Repository automation may fill missing logo and social preview metadata.</span></div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    const copyButton = document.querySelector("#skill-copy-button");
    const copyInput = document.querySelector("#skill-copy-input");

    copyButton?.addEventListener("click", async () => {
      const text = copyButton.getAttribute("data-copy-text") ?? "";

      try {
        await navigator.clipboard.writeText(text);
        if (copyInput instanceof HTMLInputElement) {
          copyInput.select();
        }
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy";
        }, 1200);
      } catch {
        if (copyInput instanceof HTMLInputElement) {
          copyInput.focus();
          copyInput.select();
        }
      }
    });
  </script>
</BaseLayout>
