{
  "name": "agentfirst-directory",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "agentfirst.directory",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentfirst-directory",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
