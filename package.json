    "ci": "npm test && npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.1",
    "markdown-it": "^14.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "25.5.0",
    "playwright": "1.62.1",
    "typescript": "6.0.2",
    "wrangler": "^4.128.0"
  }
